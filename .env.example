# StockFlow — environment variables (example)
#
# The hosted build of StockFlow needs NO environment variables: the values
# below are the effective built-in configuration, documented here so a
# self-hosted deployment can mirror them. Never commit real secrets.
#
# --- Sessions & auth ---
# SESSION_TTL_DAYS=7
# PASSWORD_HASH=PBKDF2, 120000 iterations
# LOGIN_THROTTLE_MAX_FAILURES=8
# LOGIN_THROTTLE_LOCKOUT_MINUTES=15
#
# --- Uploads & exports ---
# PRODUCT_IMAGE_MAX_BYTES=2097152
# PRODUCT_IMAGE_MAGIC_BYTE_CHECK=true
# REPORT_EXPORT_MAX_ROWS=5000
#
# --- Self-hosted (Next.js + Supabase) placeholders ---
# DATABASE_URL=postgresql://user:password@host:5432/stockflow
# DIRECT_URL=postgresql://user:password@host:5432/stockflow
# NEXTAUTH_SECRET=change-me-to-a-long-random-string
# NEXTAUTH_URL=http://localhost:3000
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
